bayes_sum2
# visualize distribution of LATE
late_draws2 <- late_draws2 %>% rename(LATE = `Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`)
ggplot(data = late_draws2, mapping = aes(x = LATE)) +
geom_density(fill = "lavender") +
geom_vline(xintercept = bayes_sum2$mean, color = "red", linetype = "dashed") +
labs(title = "LATE Distribution from Bayesian Model with R", x = "LATE") +
xlim(-0.08, 0.08) +
theme_bw()
# visualize distribution of LATE
