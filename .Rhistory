bayes_sum2 <- late_draws2 %>% summarise(
mean = mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`),
sd = sd(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`),
p_value = 2 * pmin(mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]` <= 0),
1 - mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]` <= 0)))
late_draws2 <- query_distribution(model_post2,
queries = "Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]",
using = "posteriors",
n_draws = 1000)
# pseudo-frequentist summary stats on posterior distribution of LATE
bayes_sum2 <- late_draws2 %>% summarise(
mean = mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`),
sd = sd(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`),
p_value = 2 * pmin(mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]` <= 0),
1 - mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]` <= 0)))
bayes_sum2
