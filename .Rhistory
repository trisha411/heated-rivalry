rename(date = DATE, max_temp = TMAX)
temp$date <- as.Date(temp$date, format = "%Y-%m-%d")
temp <- temp %>% filter(date >= as.Date(paste(year(date), 05, 15, sep = "-")),
date <= as.Date(paste(year(date), 09, 15, sep = "-"))) %>%
filter(year(date) >= 2018)
