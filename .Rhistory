# X parameters
1, 1, 1,
# Y|X parameters
3,  # Y.00_X.00 : strong prior that people who usually never vote will continue to do so
1, 1, 1,
2,  # mild prior non-voters stay non-voters
1, 1,
2,  # mild prior for positive effect on compliers
2,  # mild prior non-voters stay non-voters
1, 1,
2)   # mild prior for positive effect on compliers
bayes_model <- set_priors(bayes_model, alphas = priors)
# conducting a Bayesian version of the analysis from problems 1 & 2
# setting data for bayesian analysis
data_bayes <- oregon %>% transmute(Z = as.integer(treatment == 1),
X = as.integer(ohp_all_ever_nov2008 == "Enrolled"),
Y = as.integer(vote_presidential_2008_1 == 1))
# establishing relations to test in the model
# causal structure: treatment assignment effects Medicaid enrollment effects voter turnout &
#   Medicaid enrollment and voter turnout may share unobserved confounding
bayes_model <- make_model("Z -> X -> Y; X <-> Y")
# restriction that says being in the lottery cannot make anyone less likely to be in Medicaid
bayes_model <- bayes_model |> set_restrictions(decreasing("Z","X"))
# setting priors for model, default at 1 for weak uniform dirichlet weights
priors <- c(
# Z parameters
1, 1,
# X parameters
1, 1, 1,
# Y|X parameters
3,  # Y.00_X.00 : strong prior that people who usually never vote will continue to do so
1, 1, 1,
2,  # mild prior non-voters stay non-voters
1, 1,
2,  # mild prior for positive effect on compliers
2,  # mild prior non-voters stay non-voters
1, 1,
2)   # mild prior for positive effect on compliers
bayes_model <- set_priors(bayes_model, alphas = priors)
# collapses data into a summary format that CausalQueries can easily parse
compact <- collapse_data(data_bayes, model)
# collapses data into a summary format that CausalQueries can easily parse
compact <- collapse_data(data_bayes, bayes_model)
# updates the model with comllapsed data
model_post <- update_model(bayes_model, data = compact, data_type = "compact")
# drawing from posterior distribution for local average treatment effect (LATE)
late_draws <- query_distribution(model_post,
queries = "Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]",
using = "posteriors",
n_draws = 1000)
# summary stats on posterior distribution of LATE
bayes_sum <- late_draws %>% summarise(
mean = mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`),
sd = sd(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`),
q2.5 = quantile(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`, 0.025),
q97.5 = quantile(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`, 0.975),
prob_LATE_gt_0 = mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]` > 0)
)
