# establishing relations to test in the model
# structure: treatment affects Medicaid enrollment affects registration affects turnout &
#   Medicaid enrollment and voter turnout may share unobserved confounding
bayes_model2 <- make_model("Z -> X -> R -> Y; X <-> Y")
# restriction that says being in the lottery cannot make anyone less likely to be in Medicaid
bayes_model2 <- bayes_model2 |> set_restrictions(decreasing("Z","X"))
# setting priors for model, default at 1 for weak uniform dirichlet weights
priors2 <- c(
# Z priors
1, 1,
# X priors
1, 1, 1,
# R priors
3, # those not enrolled in medicaid are likely to remain unregistered
1, 1, 1,
# Y|X priors
3,  # Y.00_X.00 : strong prior that people who usually never vote will continue to do so
1, 1, 1,
2,  # mild prior non-voters stay non-voters
1, 1,
2,  # mild prior for positive effect on compliers
2,  # mild prior non-voters stay non-voters
1, 1,
2)   # mild prior for positive effect on compliers
bayes_model2 <- set_priors(bayes_model2, alphas = priors2)
# collapses data into a summary format that CausalQueries can easily parse
compact <- collapse_data(data_bayes, bayes_model2)
# updates the model with collapsed data
model_post2 <- update_model(bayes_model2, data = compact, data_type = "compact")
# drawing from posterior distribution for local average treatment effect (LATE)
late_draws2 <- query_distribution(model_post2,
queries = "Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]",
using = "posteriors",
n_draws = 1000)
# pseudo-frequentist summary stats on posterior distribution of LATE
bayes_sum2 <- late_draws %>% summarise(
mean = mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`),
sd = sd(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]`),
p_value = 2 * pmin(mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]` <= 0),
1 - mean(`Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]` <= 0)))
# drawing from posterior distribution for local average treatment effect (LATE)
late_draws2 <- query_distribution(model_post2,
queries = "Y[X=1] - Y[X=0] :|: X[Z=1] > X[Z=0]",
using = "posteriors",
n_draws = 1000)
# pseudo-frequentist summary stats on posterior distribution of LATE
